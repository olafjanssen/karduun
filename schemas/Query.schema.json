{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query",
  "type": "object",
  "properties": {
    "filter": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": { "const": "all" },
            "predicates": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["op", "predicates"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": { "const": "any" },
            "predicates": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["op", "predicates"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": { "const": "none" },
            "predicates": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["op", "predicates"],
          "additionalProperties": false
        }
      ]
    },
    "sort": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    }
  }
}

